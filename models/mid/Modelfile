# Local model for the FOMC agent: Qwen2.5 3B with an 8K context window. A middle option between speed and care.
# num_ctx: Ollama's default window is much smaller and silently cuts off long prompts, and the
# add-on cannot set it (see docs/MATLAB_GAPS.md).
# Build:  ollama pull qwen2.5:3b && ollama create fomc-mid -f models/mid/Modelfile
FROM qwen2.5:3b
PARAMETER num_ctx 8192
